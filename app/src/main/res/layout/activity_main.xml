<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C10"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".MainActivity">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/podcast_initial_background" android:gravity="center" android:text="S" android:textColor="#38BDF8" android:textSize="22sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SuperPodcast" android:textColor="#F8FAFC" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find your next listen" android:textColor="#7D8B99" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <EditText android:id="@+id/searchEditText" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/search_background" android:hint="Search podcasts or topics" android:inputType="text" android:paddingHorizontal="16dp" android:singleLine="true" android:textColor="#F8FAFC" android:textColorHighlight="#38BDF8" android:textColorHint="#64748B" />
    <Button android:id="@+id/searchButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:backgroundTint="#123447" android:text="Search" android:textAllCaps="false" android:textColor="#7DD3FC" android:textSize="16sp" android:textStyle="bold" />
    <CheckBox android:id="@+id/longTitleCheckBox" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:buttonTint="#38BDF8" android:text="Only titles with 4+ words" android:textColor="#CBD5E1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="4dp">
        <ProgressBar android:id="@+id/progressBar" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="10dp" android:indeterminateTint="#38BDF8" android:visibility="gone" />
        <TextView android:id="@+id/statusTextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Enter a search term to begin." android:textColor="#7D8B99" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="2dp" android:orientation="horizontal">
        <Button android:id="@+id/discoverTabButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:backgroundTint="#123447" android:text="Discover" android:textAllCaps="false" android:textColor="#7DD3FC" android:textStyle="bold" />
        <Button android:id="@+id/subscribedTabButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:layout_weight="1" android:backgroundTint="#151C23" android:text="Subscribed" android:textAllCaps="false" android:textColor="#94A3B8" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/listSectionTitleTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="7dp" android:text="Discover" android:textColor="#F8FAFC" android:textSize="17sp" android:textStyle="bold" />
    <ListView android:id="@+id/podcastListView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/panel_background" android:clipToPadding="false" android:divider="#1E293B" android:dividerHeight="1dp" android:paddingHorizontal="6dp" android:paddingVertical="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/player_background" android:orientation="vertical" android:padding="15dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SELECTED PODCAST" android:textColor="#38BDF8" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/selectedPodcastTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="2" android:text="No podcast selected" android:textColor="#F8FAFC" android:textSize="16sp" android:textStyle="bold" />
        <SeekBar android:id="@+id/playbackSeekBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:max="1000" android:progress="0" android:progressTint="#38BDF8" android:thumbTint="#7DD3FC" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/currentTimeTextView" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0:00" android:textColor="#94A3B8" android:textSize="11sp" />
            <TextView android:id="@+id/durationTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#94A3B8" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/subscribeButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:backgroundTint="#1C2730" android:enabled="false" android:text="Subscribe" android:textAllCaps="false" android:textColor="#E2E8F0" />
            <Button android:id="@+id/playButton" android:layout_width="0dp" android:layout_height="46dp" android:layout_marginStart="6dp" android:layout_weight="1" android:backgroundTint="#123447" android:enabled="false" android:text="Play Latest" android:textAllCaps="false" android:textColor="#7DD3FC" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>